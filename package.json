{
  "name": "morph",
  "productName": "Morph",
  "version": "0.39.0",
  "description": "M:orph (Media Browser): a local-first folder viewer where you decide how each folder is shown.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Zeke Gan",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZekeGan/Morph_media-browser.git"
  },
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/clean-test-output.mjs --older-than 24 || exit 0",
    "preshot": "node scripts/clean-test-output.mjs --older-than 24 || exit 0",
    "test": "tsx --test tests/*.test.ts",
    "test:ui:all": "node scripts/run-ui-tests.mjs",
    "test:ui:smoke": "node scripts/run-ui-tests.mjs --smoke",
    "test:ui:changed": "node scripts/run-ui-tests.mjs --changed",
    "shot": "tsx tests/support/shot.ts",
    "shot:docs": "tsx tests/support/docs-shots.ts",
    "detect": "tsx tests/support/detect.ts",
    "status": "node scripts/status.mjs",
    "stale": "node scripts/stale.mjs",
    "verify:old": "node scripts/verify-old.mjs",
    "clean:test": "node scripts/clean-test-output.mjs",
    "postinstall": "install-electron",
    "test:workspace": "tsx tests/workspace-ui.ts",
    "format": "prettier --write \"{src,shared,electron,tests,scripts}/**/*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"{src,shared,electron,tests,scripts}/**/*.{ts,tsx,mjs}\"",
    "dist": "pnpm build && electron-builder --win",
    "dist:dir": "pnpm build && electron-builder --win dir",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "music-metadata": "^12.3.4"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@videojs/react": "10.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.12.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-grid-layout": "2.2.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.3.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "io.github.zekegan.morph",
    "productName": "Morph",
    "copyright": "Copyright (C) 2024-2026 Zeke Gan",
    "directories": {
      "output": "release/morph ${version}",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "zh-TW",
      "zh-CN",
      "en-US",
      "ja",
      "es"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "M:orph",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Morph-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Morph-Portable-${version}.${ext}"
    },
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ]
  }
}
