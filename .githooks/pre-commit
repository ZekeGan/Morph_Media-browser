#!/bin/sh
# Fast checks before every commit: types, formatting and the links of the Markdown files being committed.
# Slow tests are left to the person or agent who knows what changed (pnpm test, pnpm test:ui:changed).
set -e
pnpm typecheck
pnpm format:check
# UI tests must not look for buttons or text the app no longer has (about 0.3 s).
node scripts/check-ui-names.mjs
# The renderer, shared logic and main process do not import across their layers (R-248).
node scripts/check-layers.mjs
# Every source file belongs to an area in docs/areas.json, and the tests it names exist.
node scripts/areas.mjs check
docs=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.md$' || true)
if [ -n "$docs" ]; then
  node scripts/check-docs.mjs $docs
fi
